 "roleGuide": [
  {
   "name": "Run coordinator",
   "text": "Defines the run plan according to the strategy agreed upon in the run meeting. Takes the lead in analysing the nearline histograms and prepares the report for the daily meeting."
  },
  {
   "name": "Main shifter",
   "text": "Controls the demonstrator through MIDAS. Documents the shift in the elog (run list, comments, links to other analysis elogs, etc.)."
  },
  {
   "name": "ATAR",
   "text": "Focuses on checking the behaviour of the ATAR. Can work on implementing/improving the ATAR DQM, nearline and ATAR reconstruction. Supports the run coordinator's studies."
  },
  {
   "name": "Support / DAQ",
   "text": "Focuses on the behaviour of the support detectors (MuPix, scintillators and calorimeter) and on the beam itself. Contacts the on-call expert if help is needed."
  }
 ],
 "generalGuide": [
  "The Day shifters are responsible for making sure we are taking data during the daily meeting. A video-conferencing system is in place in case some of the shifters need to stay in the counting room.",
  "The run coordinators are responsible for planning an update for the daily meeting.",
  "The counting room is small, so let's not overcrowd it: no more than 4 people in there at any time.",
  "If you are feeling sick, do not come to the counting room. If you are unsure, wear a mask. Let's try not to take the entire team down with COVID."
 ],
